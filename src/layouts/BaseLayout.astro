---
import "../styles/global.css";
import { docs } from "../data/docs";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  canonical?: string;
  isDocs?: boolean;
}

const { title, description, eyebrow = "Pi Maestro", canonical, isDocs = false } = Astro.props;
const searchIndex = docs.map(({ slug, title, description, group, content }) => ({
  slug,
  title,
  description,
  group,
  text: content.join(" "),
}));
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(currentPath, Astro.site ?? "https://pi-maestro.dev").toString();
const jsonForScript = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const structuredData = jsonForScript({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Pi Maestro",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Node.js",
  description,
  url: "https://pi-maestro.dev",
});
const serializedSearchIndex = jsonForScript(searchIndex);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#182531" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{title} — Pi Maestro</title>
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body class:list={{ "docs-body": isDocs }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand-lockup" href="/" aria-label="Pi Maestro home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="brand-name">pi maestro</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a class:list={{ active: currentPath === "/" }} href="/">Overview</a>
          <a class:list={{ active: isDocs }} href="/docs/">Docs</a>
          <a href="https://github.com/ayagmar/pi-maestro" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="header-actions">
          <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
            <span class="search-icon" aria-hidden="true">⌕</span><span>Search</span><kbd>⌘ K</kbd>
          </button>
          <a class="header-install" href="/docs/getting-started/">Install <span aria-hidden="true">→</span></a>
          <details class="mobile-menu">
            <summary aria-label="Open navigation"><span></span><span></span></summary>
            <nav aria-label="Mobile navigation">
              <a href="/">Overview</a>
              <a href="/docs/">Docs</a>
              <a href="https://github.com/ayagmar/pi-maestro" rel="noreferrer">GitHub ↗</a>
              <a href="/docs/getting-started/">Install</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand-lockup footer-brand" href="/" aria-label="Pi Maestro home">
            <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="brand-name">pi maestro</span>
          </a>
          <p class="footer-note">An orchestrator/advisor for Pi, backed by fresh-context executors and independent review.</p>
        </div>
        <div class="footer-links"><strong>Explore</strong><a href="/docs/">Documentation</a><a href="/docs/how-it-works/">How it works</a><a href="/docs/operations/">Operations</a></div>
        <div class="footer-links"><strong>Project</strong><a href="https://github.com/ayagmar/pi-maestro" rel="noreferrer">GitHub ↗</a><a href="/docs/security/">Security</a><a href="/docs/changelog/">Changelog</a></div>
      </div>
      <div class="shell footer-bottom"><span>MIT licensed · Node.js 22 or 24 · Pi 0.80.x</span><span>Built for observable execution.</span></div>
    </footer>
    <dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
      <div class="search-dialog-inner">
        <div class="search-heading"><div><span class="mono-label">FIND IN DOCS</span><h2 id="search-title">Search Pi Maestro</h2></div><button class="icon-button" type="button" data-search-close aria-label="Close search">×</button></div>
        <label class="search-input-wrap"><span aria-hidden="true">⌕</span><input data-search-input type="search" placeholder="Try “worktrees” or “review”" autocomplete="off" /></label>
        <div class="search-results" data-search-results><p class="search-empty">Search the documentation by topic, command, or concept.</p></div>
        <p class="search-hint"><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>Enter</kbd> open <kbd>Esc</kbd> close</p>
      </div>
    </dialog>
    <script type="application/json" data-search-index set:html={serializedSearchIndex}></script>
    <script is:inline>
      const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character]);
      const searchDialog = document.querySelector("[data-search-dialog]");
      const searchInput = document.querySelector("[data-search-input]");
      const searchResults = document.querySelector("[data-search-results]");
      const searchIndex = JSON.parse(document.querySelector("[data-search-index]")?.textContent || "[]");
      let activeResult = 0;
      const renderResults = (query = "") => {
        const normalized = query.trim().toLowerCase();
        const results = normalized ? searchIndex.filter((item) => `${item.title} ${item.description} ${item.group} ${item.text}`.toLowerCase().includes(normalized)).slice(0, 8) : searchIndex.slice(0, 6);
        activeResult = 0;
        searchResults.innerHTML = results.length ? results.map((item, index) => `<a class="search-result ${index === 0 ? "selected" : ""}" href="/docs/${escapeHtml(item.slug)}/"><span class="search-result-icon">↳</span><span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.group)} · ${escapeHtml(item.description)}</small></span><span aria-hidden="true">↗</span></a>`).join("") : `<p class="search-empty">No pages match “${escapeHtml(query)}”. Try a broader term.</p>`;
      };
      const openSearch = () => { searchDialog?.showModal(); renderResults(searchInput.value); requestAnimationFrame(() => searchInput.focus()); };
      document.querySelector("[data-search-open]")?.addEventListener("click", openSearch);
      document.querySelector("[data-search-close]")?.addEventListener("click", () => searchDialog?.close());
      searchDialog?.addEventListener("click", (event) => { if (event.target === searchDialog) searchDialog.close(); });
      searchInput?.addEventListener("input", (event) => renderResults(event.target.value));
      searchInput?.addEventListener("keydown", (event) => {
        const items = [...searchResults.querySelectorAll("a")];
        if (event.key === "ArrowDown" || event.key === "ArrowUp") { if (!items.length) return; event.preventDefault(); activeResult = (activeResult + (event.key === "ArrowDown" ? 1 : items.length - 1)) % items.length; items.forEach((item, index) => item.classList.toggle("selected", index === activeResult)); items[activeResult]?.scrollIntoView({ block: "nearest" }); }
        if (event.key === "Enter" && items[activeResult]) items[activeResult].click();
      });
      document.addEventListener("keydown", (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") { event.preventDefault(); openSearch(); } if (event.key === "Escape" && searchDialog?.open) searchDialog.close(); });
      document.querySelectorAll("[data-copy]").forEach((button) => button.addEventListener("click", async () => { const text = button.closest(".code-block")?.querySelector("code")?.textContent || button.dataset.copy || ""; try { await navigator.clipboard.writeText(text); button.textContent = "Copied"; setTimeout(() => button.textContent = "Copy", 1600); } catch { button.textContent = "Select to copy"; } }));
    </script>
  </body>
</html>
