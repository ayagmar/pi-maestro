---
import "../styles/global.css";
import { url } from "../data/site.mjs";

interface Props {
  title: string;
  description: string;
  isDocs?: boolean;
}

const { title, description, isDocs = false } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site).toString();
const isHome = currentPath === url("/");
const pageTitle = isHome ? title : `${title} | Pi Maestro`;
const repository = "https://github.com/ayagmar/pi-maestro";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#182531" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "docs-body": isDocs }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand-lockup" href={url("/")} aria-label="Pi Maestro home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="brand-name">pi maestro</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary">
          <a href={url("/")} aria-current={isHome ? "page" : undefined}>Overview</a>
          <a href={url("/docs/")} aria-current={isDocs ? "true" : undefined}>Docs</a>
          <a href={repository} rel="noreferrer">GitHub</a>
        </nav>
        <div class="header-actions">
          <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
            <span class="search-icon" aria-hidden="true">⌕</span><span class="search-label">Search</span><kbd aria-hidden="true">Ctrl K</kbd>
          </button>
          <a class="header-install" href={url("/docs/getting-started/")}>Install</a>
          <details class="mobile-menu">
            <summary aria-label="Menu"><span class="menu-bar"></span><span class="menu-bar"></span></summary>
            <nav aria-label="Mobile">
              <a class="menu-link" href={url("/")}>Overview</a>
              <a class="menu-link" href={url("/docs/")}>Docs</a>
              <a class="menu-link" href={repository} rel="noreferrer">GitHub</a>
              <a class="menu-link" href={url("/docs/getting-started/")}>Install</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand-lockup footer-brand" href={url("/")} aria-label="Pi Maestro home">
            <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="brand-name">pi maestro</span>
          </a>
          <p class="footer-note">An orchestrator for Pi, backed by fresh-context executors and independent review.</p>
        </div>
        <div class="footer-links"><strong>Docs</strong><a href={url("/docs/getting-started/")}>Getting started</a><a href={url("/docs/how-it-works/")}>How it works</a><a href={url("/docs/operations/")}>Operations</a></div>
        <div class="footer-links"><strong>Project</strong><a href={repository} rel="noreferrer">GitHub</a><a href={url("/docs/security/")}>Security</a><a href={url("/docs/changelog/")}>Changelog</a></div>
      </div>
      <div class="shell footer-bottom"><span>MIT licensed</span><span>Node.js 22.19+ · Pi 1.5+</span></div>
    </footer>
    <dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
      <div class="search-dialog-inner">
        <div class="search-heading"><h2 id="search-title">Search the docs</h2><button class="icon-button" type="button" data-search-close aria-label="Close search">×</button></div>
        <label class="search-input-wrap"><span class="sr-only">Search</span><span aria-hidden="true">⌕</span><input data-search-input type="search" role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" placeholder="worktrees, budget_blocked, retry" autocomplete="off" /></label>
        <div class="search-results" id="search-results" role="listbox" aria-label="Results" data-search-results></div>
        <p class="search-status" role="status" data-search-status></p>
      </div>
    </dialog>
    <script is:inline define:vars={{ searchIndexUrl: url("/search-index.json"), docsBase: url("/docs/") }}>
      (() => {
        const dialog = document.querySelector("[data-search-dialog]");
        const input = document.querySelector("[data-search-input]");
        const list = document.querySelector("[data-search-results]");
        const status = document.querySelector("[data-search-status]");
        let entries;
        let shown = [];
        let active = 0;

        const load = async () => {
          if (entries) return entries;
          try {
            entries = await (await fetch(searchIndexUrl)).json();
          } catch {
            entries = [];
            status.textContent = "Search could not load. Browse the documentation index instead.";
          }
          return entries;
        };
        const score = (entry, words) => {
          const heading = `${entry.page} ${entry.heading}`.toLowerCase();
          const body = entry.text.toLowerCase();
          let total = 0;
          for (const word of words) {
            if (heading.includes(word)) total += 5;
            else if (body.includes(word)) total += 1;
            else return 0;
          }
          return total;
        };
        const render = () => {
          list.replaceChildren(
            ...shown.map((entry, index) => {
              const link = document.createElement("a");
              link.className = "search-result";
              link.id = `search-result-${index}`;
              link.setAttribute("role", "option");
              link.setAttribute("aria-selected", String(index === active));
              link.href = `${docsBase}${entry.slug}/${entry.anchor ? `#${entry.anchor}` : ""}`;
              const title = document.createElement("strong");
              title.textContent = entry.heading ? `${entry.page}: ${entry.heading}` : entry.page;
              const detail = document.createElement("small");
              detail.textContent = entry.text.slice(0, 110);
              link.append(title, detail);
              return link;
            })
          );
          input.setAttribute("aria-activedescendant", shown.length ? `search-result-${active}` : "");
        };
        const search = async () => {
          const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
          const all = await load();
          shown = words.length
            ? all
                .map((entry) => ({ entry, rank: score(entry, words) }))
                .filter((item) => item.rank > 0)
                .sort((a, b) => b.rank - a.rank)
                .slice(0, 8)
                .map((item) => item.entry)
            : [];
          active = 0;
          render();
          status.textContent = !words.length ? "Type a word to search the documentation." : shown.length ? `${shown.length} results` : `No results for "${input.value.trim()}".`;
        };
        const open = () => {
          if (!dialog.open) dialog.showModal();
          input.focus();
          void search();
        };
        const move = (offset) => {
          if (!shown.length) return;
          active = (active + offset + shown.length) % shown.length;
          render();
          document.getElementById(`search-result-${active}`)?.scrollIntoView({ block: "nearest" });
        };

        document.querySelector("[data-search-open]").addEventListener("click", open);
        document.querySelector("[data-search-close]").addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
        input.addEventListener("input", () => void search());
        input.addEventListener("keydown", (event) => {
          if (event.key === "ArrowDown") move(1);
          else if (event.key === "ArrowUp") move(-1);
          else if (event.key === "Enter") document.getElementById(`search-result-${active}`)?.click();
          else return;
          event.preventDefault();
        });
        document.addEventListener("keydown", (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            open();
          }
        });

        const copy = async (button, text) => {
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
          } catch {
            button.textContent = "Press Ctrl C";
            const range = document.createRange();
            range.selectNodeContents(button.closest(".code-block").querySelector("code"));
            getSelection().removeAllRanges();
            getSelection().addRange(range);
          }
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        };
        for (const button of document.querySelectorAll("[data-copy]")) {
          button.addEventListener("click", () => copy(button, button.dataset.copy));
        }
        for (const pre of document.querySelectorAll(".prose pre")) {
          const wrapper = document.createElement("div");
          wrapper.className = "code-block";
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-button";
          button.textContent = "Copy";
          button.setAttribute("aria-label", "Copy code block");
          button.addEventListener("click", () => copy(button, pre.textContent));
          pre.replaceWith(wrapper);
          wrapper.append(button, pre);
        }
      })();
    </script>
  </body>
</html>
