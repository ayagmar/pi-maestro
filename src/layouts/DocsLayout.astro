---
import { docs, getDoc } from "../data/docs";
import { url } from "../data/site.mjs";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  slug: string;
  headings?: { slug: string; text: string }[];
}
const { slug, headings = [] } = Astro.props;
const doc = getDoc(slug);
const groups = [...new Set(docs.map((item) => item.group))];
const position = docs.findIndex((item) => item.slug === slug);
const previous = docs[position - 1];
const next = docs[position + 1];
const href = (item: { slug: string }) => url(`/docs/${item.slug}/`);
---
<BaseLayout title={doc.title} description={doc.description} isDocs>
  <div class="docs-shell shell">
    <aside class="docs-sidebar" aria-label="Documentation">
      <nav aria-label="Documentation pages">
        {groups.map((group) => (
          <div class="docs-nav-group">
            <h2>{group}</h2>
            {docs
              .filter((item) => item.group === group)
              .map((item) => (
                <a href={href(item)} aria-current={item.slug === slug ? "page" : undefined}>
                  {item.title}
                </a>
              ))}
          </div>
        ))}
      </nav>
      <a class="docs-sidebar-github" href={`https://github.com/ayagmar/pi-maestro/blob/master/${doc.file}`} rel="noreferrer">
        Edit this page on GitHub
      </a>
    </aside>
    <section class="docs-content">
      <details class="docs-mobile-nav">
        <summary>Documentation pages</summary>
        <nav aria-label="Documentation pages">
          {docs.map((item) => (
            <a class="menu-link" href={href(item)} aria-current={item.slug === slug ? "page" : undefined}>{item.title}</a>
          ))}
        </nav>
      </details>
      <header class="docs-hero">
        <p class="docs-group">{doc.group}</p>
        <h1>{doc.title}</h1>
        <p>{doc.description}</p>
      </header>
      {headings.length > 2 && (
        <nav class="docs-toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {headings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <slot />
      <nav class="docs-next" aria-label="Previous and next pages">
        {previous && <a href={href(previous)}><span>Previous</span><strong>{previous.title}</strong></a>}
        {next && <a class="next" href={href(next)}><span>Next</span><strong>{next.title}</strong></a>}
      </nav>
    </section>
  </div>
</BaseLayout>
