---
import {
  exampleBoard, exampleEvidence, exampleRejection, exampleSpend, exampleStatusLine,
} from "../data/example-board.js";
import { installCommand, npmInstallCommand } from "../data/install.js";
import { url } from "../data/site.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";

const guides = [
  ["commands", "Commands", "Inspect a task, steer a running executor, or read its verdict."],
  ["configuration", "Models and budgets", "Choose executor tiers, review policy, and spending limits."],
  ["operations", "Recovery", "Find out why a drive stopped and when it can resume."],
  ["security", "Trust boundaries", "Check what executors can write and who can define verification commands."],
];
---
<BaseLayout title="Pi Maestro: a reviewed task board for Pi" description="Run tasks in separate Pi sessions, review each result, and track retries and spend on a local board.">
  <div class="shell manual">
    <div class="manual-opening">
      <header class="manual-intro">
        <h1>Pi Maestro</h1>
        <p class="manual-lede">Run coding tasks in separate Pi sessions.</p>
        <p>Your Pi session plans the work. Each executor gets a task brief and the reports from its dependencies. By default, a separate reviewer checks the result against the brief before dependent tasks can run.</p>
        <h2>Install</h2>
        <div class="code-block manual-install">
          <button class="copy-button" type="button" data-copy={installCommand} aria-label="Copy shell install command">Copy</button>
          <pre><code>{installCommand}</code></pre>
        </div>
        <p class="requirements">Pi 1.5+ · Node.js 22.19+</p>
        <details class="install-options">
          <summary>Other install options</summary>
          <p>For a published release, use <code>{npmInstallCommand}</code>. To pin a Git commit or install a local checkout, see the <a href={url("/docs/getting-started/")}>installation guide</a>.</p>
        </details>
      </header>
      <figure class="run-sheet">
        <figcaption><span>Session API migration</span><small>Example run</small></figcaption>
        <table>
          <caption class="sr-only">Task board for an example migration, including spend per task</caption>
          <thead><tr><th scope="col">Task</th><th scope="col">Status</th><th scope="col">Spend</th></tr></thead>
          <tbody>{exampleBoard.tasks.map(task => (
            <tr><th scope="row"><code>{task.id}</code> {task.title}</th><td class={`run-state state-${task.status}`}>{task.status}</td><td>{exampleSpend(task.id)}</td></tr>
          ))}</tbody>
        </table>
        <p class="run-total"><code>{exampleStatusLine}</code></p>
        <div class="run-review">
          <h2>Why T2 is running again</h2>
          <p>The adapter compiled on the first attempt, but its tests still used the old token helper. The reviewer requested changes. T3 waits for T2 to pass.</p>
          <details><summary>Review evidence for attempt 1</summary>
            <p><code>{exampleEvidence.path}</code></p>
            <ul>{exampleRejection.criterionEvidence.map(item => <li><strong>{item.passed ? "Pass" : "Fail"}</strong> {item.evidence}</li>)}</ul>
          </details>
        </div>
      </figure>
    </div>
    <div class="manual-guides">
      <section id="first-run" aria-labelledby="first-run-title">
        <h2 id="first-run-title">Run your first board</h2>
        <p>Start Pi in a Git repository with at least one commit. Enter these commands in Pi, not in your shell.</p>
        <dl class="run-commands">
          <dt><code>/maestro doctor</code></dt><dd>Check your model, credentials, and Git setup.</dd>
          <dt><code>/maestro start migrate the session API and add tests</code></dt><dd>Ask Pi to plan the migration. If plan approval is enabled, open <code>/maestro plan</code>, review the tasks, and choose <strong>Approve plan</strong> before continuing.</dd>
          <dt><code>/maestro drive</code></dt><dd>Run the tasks and their reviews. Open <code>/maestro board</code> to watch without calling a model.</dd>
        </dl>
      </section>
      <nav class="manual-reference" aria-labelledby="reference-title">
        <h2 id="reference-title">Reference</h2>
        <ul>{guides.map(([slug, title, description]) => <li><a href={url(`/docs/${slug}/`)}>{title}</a><p>{description}</p></li>)}</ul>
        <a href={url("/docs/")}>All documentation</a>
      </nav>
    </div>
  </div>
</BaseLayout>
