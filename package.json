{
  "name": "pi-maestro",
  "version": "0.1.0",
  "description": "Orchestrator/executor workflows for pi: plan tasks, run cheap fresh-context executors in parallel, adversarially review, and track everything on a live board",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayagmar/pi-maestro.git"
  },
  "homepage": "https://github.com/ayagmar/pi-maestro#readme",
  "bugs": "https://github.com/ayagmar/pi-maestro/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "orchestrator",
    "subagents",
    "multi-agent"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke-test": "node ./scripts/run-isolated.mjs node --import=tsx ./scripts/smoke-test.mjs",
    "package-smoke-test": "node ./scripts/package-smoke-test.mjs",
    "test": "node ./scripts/run-isolated.mjs node --import=tsx --test ./test/*.test.ts",
    "check": "pnpm run typecheck && pnpm run smoke-test && pnpm run package-smoke-test && pnpm test && pnpm run lint && pnpm run format:check",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^26.1.1",
    "astro": "^7.1.1",
    "tsx": "^4.23.1",
    "typebox": "^1.1.38",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
