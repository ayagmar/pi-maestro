{
  "name": "@ayagmar/pi-maestro",
  "version": "0.1.0",
  "description": "Orchestrator/executor workflows for pi: plan tasks, run cheap fresh-context executors in parallel, adversarially review, and track everything on a live board",
  "keywords": [
    "pi-package",
    "pi-extension",
    "orchestrator",
    "subagents",
    "multi-agent"
  ],
  "license": "MIT",
  "author": "ayagmar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayagmar/pi-maestro.git"
  },
  "homepage": "https://ayagmar.github.io/pi-maestro/",
  "bugs": {
    "url": "https://github.com/ayagmar/pi-maestro/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "!src/pages/",
    "!src/layouts/",
    "!src/styles/",
    "!src/data/",
    "docs/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node ./scripts/run-isolated.mjs node --import=tsx --test ./test/*.test.ts",
    "test:integration": "node ./scripts/run-isolated.mjs node --import=tsx --test ./test/integration/*.test.ts",
    "smoke-test": "node --import=tsx ./scripts/smoke-test.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run test:integration && pnpm run smoke-test",
    "release:dry": "release-it --ci --dry-run",
    "dev": "astro dev",
    "build": "astro build",
    "site:check": "node ./scripts/check-site-links.mjs dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "^1.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "astro": "^7.4.8",
    "release-it": "^21.1.2",
    "tsx": "^4.23.15",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.8.1",
  "publishConfig": {
    "access": "public"
  }
}
